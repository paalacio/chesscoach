{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tung Tung Chessahur",
  "version": "1.0.1",
  "identifier": "app.chesscoach.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tung Tung Chessahur",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Study chess openings with Stockfish and Claude",
    "license": "GPL-3.0-or-later",
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/stockfish"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
