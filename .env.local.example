# Copy this file to .env.local (which git ignores) and fill it in.
# Only used during development (`pnpm tauri dev`) to pre-fill empty Settings.
# The real app reads these values from Settings instead.

# Your Chess.com username (used for imports and the User-Agent)
CHESSCOM_USERNAME=
# Contact email or URL that Chess.com asks for in the User-Agent header
CHESSCOM_CONTACT=
