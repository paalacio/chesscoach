{
  "name": "chesscoach",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --port 1430",
    "build": "tsc && vite build",
    "build:mock": "tsc && vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --grep @screenshot",
    "fetch-stockfish": "node scripts/fetch-stockfish.mjs",
    "openings": "node scripts/build-openings.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-os": "2.4.0",
    "chessops": "0.15.1",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "6.0.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
